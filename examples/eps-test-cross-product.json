e":"file","type":"STRING","widget":{"name":"file"},"link":null},{"localized_name":"entry","name":"entry","type":"STRING","widget":{"name":"entry"},"link":null}],"outputs":[{"localized_name":"text","name":"text","shape":6,"type":"STRING","links":[4]},{"localized_name":"name","name":"name","shape":6,"type":"STRING","links":[5]}],"title":"Four prompts (pre-selected)","properties":{"Node name for S&R":"LoraLibraryNotebook"},"widgets_values":["eps-cross-test-prompts.md","Neon City\nGolden Hour\nInk Sketch\nPastel Studio"]},{"id":5,"type":"EPSCrossProduct","pos":[-240,380],"size":[164.355078125,66],"flags":{},"order":8,"mode":0,"inputs":[{"localized_name":"images","name":"images","type":"IMAGE","link":3},{"localized_name":"texts","name":"texts","type":"STRING","link":4},{"localized_name":"names","name":"names","shape":7,"type":"STRING","link":5}],"outputs":[{"localized_name":"image","name":"image","shape":6,"type":"IMAGE","links":[6]},{"localized_name":"text","name":"text","shape":6,"type":"STRING","links":null},{"localized_name":"name","name":"name","shape":6,"type":"STRING","links":[7]}],"properties":{"Node name for S&R":"EPSCrossProduct"}},{"id":6,"type":"SaveImage","pos":[120,380],"size":[270,58],"flags":{},"order":9,"mode":0,"inputs":[{"localized_name":"images","name":"images","type":"IMAGE","link":6},{"localized_name":"filename_prefix","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":7}],"outputs":[{"localized_name":"images","name":"images","type":"IMAGE","links":null}],"title":"Saves 8 - filenames prove the pairing","properties":{},"widgets_values":["ComfyUI"]},{"id":7,"type":"MarkdownNote","pos":[-1100,-560],"size":[900,470],"flags":{},"order":3,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["# TEST: EPS Cross Product - 2 images x 4 prompts = 8\n\n**Setup (one time):** copy `eps-cross-test-prompts.md` (ships beside this file) into your EPSNodes library folder - the one in Settings -> EPSNodes. That is the only prep.\n\n**Then just press Run.** No checkpoint, no lora, no GPU needed - it only moves images around.\n\n## What should happen\n\n**8 images** appear in your output folder, named by prompt:\n\n```\nNeon City_00001_.png      <- Image A\nGolden Hour_00001_.png    <- Image A\nInk Sketch_00001_.png     <- Image A\nPastel Studio_00001_.png  <- Image A\nNeon City_00002_.png      <- Image B\nGolden Hour_00002_.png    <- Image B\nInk Sketch_00002_.png     <- Image B\nPastel Studio_00002_.png  <- Image B\n```\n\nEach prompt name appears exactly **twice** (once per image). That is the fix: without EPS Cross Product you would get 4 images, three of them reusing the last picture.\n\n**Try it your way too:** swap the two Load Image nodes for your own, or replace the switcher with an **EPS Image Grid** set to *Emit* (wire its `image` output into Cross Product's `images`) - the count follows whatever is in the grid."],"color":"#432","bgcolor":"#653"},{"id":8,"type":"MarkdownNote","pos":[-700,-60],"size":[380,180],"flags":{},"order":4,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["## Two images in\n\nAny 2-image source works. Both switcher rows are ON. An EPS Image Grid in Emit mode drops in here just as well."],"color":"#432","bgcolor":"#653"},{"id":9,"type":"MarkdownNote","pos":[-700,900],"size":[400,200],"flags":{},"order":5,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["## Four prompts\n\nThe Prompt Notebook has all four entries pre-selected (ctrl/cmd+click toggles them). Selecting fewer changes the math: 2 images x 3 prompts = 6."],"color":"#432","bgcolor":"#653"},{"id":10,"type":"MarkdownNote","pos":[-240,100],"size":[400,220],"flags":{},"order":6,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["## The cross\n\nEvery image paired with every prompt: 2 x 4 = **8**. The `name` output carries each prompt's title through, which is what names the files below."],"color":"#432","bgcolor":"#653"}],"links":[[1,1,0,3,0,"IMAGE"],[2,2,0,3,2,"IMAGE"],[3,3,0,5,0,"IMAGE"],[4,4,0,5,1,"STRING"],[5,4,1,5,2,"STRING"],[6,5,0,6,0,"IMAGE"],[7,5,2,6,1,"STRING"]],"groups":[{"id":1,"title":"Sources","bounding":[-1150,-30,780,1000],"color":"#3f789e","flags":{}},{"id":2,"title":"Cross Product","bounding":[-290,60,300,480],"color":"#8A8","flags":{}},{"id":3,"title":"Result","bounding":[60,300,380,240],"color":"#a1309b","flags":{}}],"config":{},"extra":{"ds":{"scale":0.6792452830188679,"offset":[146.66666666666674,132.5]}},"version":0.4}