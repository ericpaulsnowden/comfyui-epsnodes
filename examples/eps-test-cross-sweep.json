ame":"model","name":"model","type":"MODEL","link":23},{"localized_name":"positive","name":"positive","type":"CONDITIONING","link":24},{"localized_name":"negative","name":"negative","type":"CONDITIONING","link":25},{"localized_name":"latent_image","name":"latent_image","type":"LATENT","link":26},{"localized_name":"seed","name":"seed","type":"INT","widget":{"name":"seed"},"link":null},{"localized_name":"steps","name":"steps","type":"INT","widget":{"name":"steps"},"link":null},{"localized_name":"cfg","name":"cfg","type":"FLOAT","widget":{"name":"cfg"},"link":null},{"localized_name":"sampler_name","name":"sampler_name","type":"COMBO","widget":{"name":"sampler_name"},"link":null},{"localized_name":"scheduler","name":"scheduler","type":"COMBO","widget":{"name":"scheduler"},"link":null},{"localized_name":"denoise","name":"denoise","type":"FLOAT","widget":{"name":"denoise"},"link":null}],"outputs":[{"localized_name":"LATENT","name":"LATENT","type":"LATENT","links":[27]}],"properties":{"Node name for S&R":"KSampler"},"widgets_values":[42,"fixed",15,7,"euler","normal",0.6]},{"id":15,"type":"VAEDecode","pos":[960,800],"size":[140,46],"flags":{},"order":18,"mode":0,"inputs":[{"localized_name":"samples","name":"samples","type":"LATENT","link":27},{"localized_name":"vae","name":"vae","type":"VAE","link":28}],"outputs":[{"localized_name":"IMAGE","name":"IMAGE","type":"IMAGE","links":[29]}],"properties":{"Node name for S&R":"VAEDecode"}},{"id":16,"type":"SaveImage","pos":[1300,800],"size":[270,58],"flags":{},"order":19,"mode":0,"inputs":[{"localized_name":"images","name":"images","type":"IMAGE","link":29},{"localized_name":"filename_prefix","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":30}],"outputs":[{"localized_name":"images","name":"images","type":"IMAGE","links":null}],"title":"One folder per strength","properties":{},"widgets_values":["ComfyUI"]},{"id":17,"type":"MarkdownNote","pos":[-1500,-700],"size":[1000,600],"flags":{},"order":4,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["# TEST: EPS Cross Sweep - 3 strengths x 8 pairs = 24 images, foldered\n\n**Setup (3 things, all marked on the canvas):**\n\n1. Copy `eps-cross-test-prompts.md` (ships beside this file) into your EPSNodes library folder.\n2. **PICK YOUR CHECKPOINT** on the red-titled loader (bottom left).\n3. **PICK A LORA STATE** on EPS Apply LoRA Set next to it (make one with the State Controller if you have none).\n\nThen press Run once. **This is a real generation run: 24 images.** At ~15 steps each that is a few minutes on a decent GPU - deliberately sized for a first check, not an overnight job.\n\n## What should happen\n\nYour output folder gets **one folder per strength**, each holding the 8 pairs:\n\n```\noutput/eps_sweeptest/\n  <loraname>_0.0/   Neon City_00001_.png  Golden Hour_00001_.png  ... (8 files)\n  <loraname>_0.5/   Neon City_00001_.png  Golden Hour_00001_.png  ... (8 files)\n  <loraname>_1.0/   Neon City_00001_.png  Golden Hour_00001_.png  ... (8 files)\n```\n\nSame seed (42, fixed) across all 24, denoise 0.6 - so within a folder the only thing changing is the prompt, and between folders the only thing changing is lora strength. That is the clean A/B.\n\n## Scaling it up when it looks right\n\n- **More strengths:** drop the sweep `increment` (0.5 -> 0.1 gives 11 strengths = 88 images).\n- **Multiple loras:** the sweep is set to *All together* so the count stays predictable. Switch it to *Each lora independently* and the run multiplies by the number of loras in your state.\n- **Fewer/more pairs:** change how many prompts are selected in the notebook, or the images.\n\n**Watch the total:** strengths x images x prompts. That is the number of generations queued as ONE job."],"color":"#432","bgcolor":"#653"},{"id":18,"type":"MarkdownNote","pos":[-1120,-60],"size":[380,200],"flags":{},"order":5,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["## Pairs side\n\nTwo images -> normalized to fit 1024 (multiple of 8, so img2img is happy) -> crossed with the four prompts = 8 pairs."],"color":"#432","bgcolor":"#653"},{"id":19,"type":"MarkdownNote","pos":[-300,700],"size":[400,230],"flags":{},"order":6,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["## The multiply\n\nSweep (3 strengths) x pairs (8) = **24 runs**, grouped strength-first. `save_prefix` builds `eps_sweeptest/<lora>_<strength>/<prompt name>` and feeds Save Image, which is what creates the folders."],"color":"#432","bgcolor":"#653"},{"id":20,"type":"MarkdownNote","pos":[-1500,1500],"size":[900,200],"flags":{},"order":7,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["## Model side\n\nCheckpoint -> Apply LoRA Set (your saved state) -> LoRA Sweep. The sweep hands out one patched model/clip per strength step; Cross Sweep pairs each of those with every image/prompt pair."],"color":"#432","bgcolor":"#653"}],"links":[[1,1,0,3,0,"IMAGE"],[2,2,0,3,2,"IMAGE"],[3,3,0,4,0,"IMAGE"],[4,4,1,6,0,"IMAGE"],[5,5,0,6,1,"STRING"],[6,5,1,6,2,"STRING"],[7,7,0,8,0,"MODEL"],[8,7,1,8,1,"CLIP"],[9,8,0,9,0,"MODEL"],[10,8,1,9,2,"CLIP"],[11,8,2,9,1,"LORA_STACK"],[12,9,0,10,0,"MODEL"],[13,9,1,10,1,"CLIP"],[14,9,2,10,2,"STRING"],[15,6,0,10,3,"IMAGE"],[16,6,1,10,4,"STRING"],[17,6,2,10,5,"STRING"],[18,10,1,11,0,"CLIP"],[19,10,3,11,1,"STRING"],[20,10,1,12,0,"CLIP"],[21,10,2,13,0,"IMAGE"],[22,7,2,13,1,"VAE"],[23,10,0,14,0,"MODEL"],[24,11,0,14,1,"CONDITIONING"],[25,12,0,14,2,"CONDITIONING"],[26,13,0,14,3,"LATENT"],[27,14,0,15,0,"LATENT"],[28,7,2,15,1,"VAE"],[29,15,0,16,0,"IMAGE"],[30,10,4,16,1,"STRING"]],"groups":[{"id":1,"title":"1 - Images + prompts -> 8 pairs","bounding":[-1550,160,1220,800],"color":"#3f789e","flags":{}},{"id":2,"title":"2 - Checkpoint + lora sweep","bounding":[-1550,1060,1180,320],"color":"#b58b2a","flags":{}},{"id":3,"title":"3 - Cross Sweep","bounding":[-350,940,300,380],"color":"#8A8","flags":{}},{"id":4,"title":"4 - Generate + save into folders","bounding":[60,540,1500,900],"color":"#a1309b","flags":{}}],"config":{},"extra":{"ds":{"scale":0.6792452830188679,"offset":[146.66666666666674,132.5]}},"version":0.4}